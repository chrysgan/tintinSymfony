<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://kit.fontawesome.com/1cd1b826c6.js" crossorigin="anonymous"></script>
        {% endblock %}
    </head>
    <body>
        <nav class="navbar">
            <button class="burger" id="burger">☰</button>
            <div class="logo">
                <img src="{{ asset('images/illustrations/logo.png') }}" alt="Logo Tintin">
                <span>Les Figurines de Tintin</span>
            </div>
            <ul class= "nav-links" id="navLinks">
                <li><a href="{{ url('app_home') }}">Accueil</a></li>
                <li><a href="{{ url('app_gallery') }}">La galerie</a></li>
                <li><a href="{{ url('app_admin') }}">Admin</a></li>
            </ul>
            <a class="fa-color" href="{{ url('app_test') }}"><i class="fa-regular fa-user"></i></a>
        </nav>
        {% block body %}{% endblock %}
    </body>
</html>
